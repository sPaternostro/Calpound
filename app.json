{
  "expo": {
    "name": "Calpound",
    "slug": "calpound",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "calpound",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.eztrazluz.calpound",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Calpound usa la cámara para leer códigos de barras de alimentos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.eztrazluz.calpound",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F4F1EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F4F1EA"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Calpound usa la cámara para leer códigos de barras de alimentos.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bb2d7e63-a50a-4846-99ae-a5a800c49ee3"
      }
    },
    "owner": "eztrazluzs-team"
  }
}
